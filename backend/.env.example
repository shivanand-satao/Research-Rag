SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
FRONTEND_URL=http://127.0.0.1:5173
RESEARCH_REDIRECT_URL=http://127.0.0.1:5173/auth/callback
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
# A dedicated collection; do not use a reference application's collection.
RESEARCH_QDRANT_COLLECTION=research_rag_chunks
RESEARCH_STORAGE_BUCKET=research-documents
# Embeddings always use Qdrant Cloud MiniLM; enable inference on the cluster.
GROQ_API_KEY=
GENERATION_MODEL=openai/gpt-oss-120b
# Answer-generation budget is separate from MiniLM's per-text embedding window.
RESEARCH_ANSWER_INPUT_TOKENS=3500
RESEARCH_ANSWER_MAX_TOKENS=1400
RESEARCH_GENERATION_RETRIES=2
RESEARCH_GENERATION_RETRY_WAIT=8
GROQ_BASE_URL=https://api.groq.com/openai/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OCR=false
OCR_LANGUAGE=eng
TESSERACT_CMD=
RESEARCH_RERANK_ENABLED=false
RESEARCH_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RESEARCH_CHILD_TOKENS=360
RESEARCH_PARENT_TOKENS=1600
RESEARCH_CONTEXT_TOKENS=12000

